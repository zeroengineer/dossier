{
  "id": "sample-letter",
  "version": 1,
  "type": "Offer Letter",
  "title": "Sample letter",
  "category": "letter",
  "layoutProfile": "letter",
  "partyType": "Person",
  "partyKind": "person",
  "sensitivity": "Confidential",
  "renditions": ["pdf", "html", "md"],
  "numbering": { "series": "brand", "required": true },
  "contact": "hr",
  "params": { "subject": "Letter of appointment" },
  "fields": [
    { "name": "brand", "source": "brand", "required": true },
    { "name": "person", "label": "Employee", "source": "entity:person", "required": true },
    { "name": "address", "source": "person.attrs.address", "type": "text" },
    { "name": "date", "source": "today", "type": "date" },
    { "name": "joining", "label": "Joining date", "source": "ask", "type": "date", "required": true, "help": "First working day" },
    { "name": "salary", "label": "Monthly salary", "source": "ask", "type": "money", "required": true },
    { "name": "annual", "source": "computed:annual", "type": "money" },
    { "name": "bank", "source": "brand.bankAccounts.0" },
    { "name": "issuer.name", "source": "brand.legalName" },
    { "name": "signatory", "source": "signatory", "required": true },
    { "name": "taxMode", "source": "ask", "type": "enum", "enum": "brand.tax.modes", "default": "brand.tax.defaultMode" },
    { "name": "probationMonths", "source": "const:6", "type": "number" },
    { "name": "remote", "source": "ask", "type": "boolean", "default": false },
    { "name": "perks", "source": "ask", "type": "array", "item": { "label": "string", "amount": "money" } },
    { "name": "team", "source": "ask", "enum": ["design", "operations"] },
    { "name": "firstPerk", "source": "perks.0.amount", "type": "money" },
    { "name": "listedSalary", "source": "person.attrs.salary", "type": "money" }
  ],
  "relations": [{ "type": "based_on", "field": "person", "optional": true }],
  "leaf": "Offer Letters"
}
