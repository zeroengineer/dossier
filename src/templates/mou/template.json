{
  "id": "mou",
  "version": 1,
  "type": "MoU",
  "title": "Memorandum of understanding",
  "description": "Memorandum of understanding with a partner organisation, either a framework for all its events (variant organisation) or for one event (variant event). The text is the Markdown body; a workspace override supplies its own body.md / body.event.md.",
  "category": "agreement",
  "layoutProfile": "mou",
  "partyType": "Client",
  "partyKind": "client",
  "sensitivity": "Confidential",
  "renditions": ["pdf", "html", "md"],
  "numbering": { "series": "brand", "required": false },
  "contact": "default",
  "params": {
    "registrationLabel": "CIN",
    "watermark": { "text": "DRAFT — DO NOT SIGN" },
    "variants": {
      "organisation": {},
      "event": { "frame": { "signature": { "cardHeight": 205, "fields": ["Name", "Designation", "Contact", "Date", "Seal"] } } }
    }
  },
  "fields": [
    { "name": "brand", "source": "brand", "required": true },
    { "name": "variant", "label": "Variant", "source": "ask", "type": "enum", "enum": ["organisation", "event"], "default": "organisation",
      "help": "organisation: one MoU for all the partner's events; event: one event" },
    { "name": "partner", "label": "Partner organisation", "source": "entity:client", "required": true },
    { "name": "engagement", "label": "Event (engagement)", "source": "entity:engagement", "help": "Event variant: the event; stored on the document" },
    { "name": "partnerName", "label": "Partner name", "source": "partner.name", "type": "string", "required": true },
    { "name": "partnerKind", "label": "Kind of organisation", "source": "ask", "type": "string", "default": "a registered organisation",
      "help": "With its article, e.g. \"a company\", \"a trust\", \"an educational institution\"" },
    { "name": "partnerRegistration", "label": "Partner registration no.", "source": "partner.attrs.registration", "type": "string" },
    { "name": "partnerAddress", "label": "Partner address", "source": "partner.attrs.address" },
    { "name": "partnerEmail", "label": "Partner email", "source": "partner.attrs.email", "type": "string" },
    { "name": "partnerPhone", "label": "Partner phone", "source": "partner.attrs.phone", "type": "string" },
    { "name": "partnerContact", "label": "Partner contact person", "source": "ask", "type": "string" },
    { "name": "partnerSignatory", "label": "Partner signatory", "source": "ask", "type": "object",
      "help": "{ name, designation, contact } printed on the partner's signature card; leave empty for blank lines" },
    { "name": "event.name", "label": "Event name", "source": "engagement.name", "type": "string" },
    { "name": "event.type", "label": "Event type", "source": "ask", "type": "string" },
    { "name": "event.dates", "label": "Event dates", "source": "ask", "type": "string" },
    { "name": "event.venue", "label": "Event venue", "source": "ask", "type": "string" },
    { "name": "service", "label": "Platform or service", "source": "ask", "type": "string", "required": true,
      "help": "Name of the platform or service the first party provides" },
    { "name": "date", "label": "Date", "source": "today", "type": "date", "required": true },
    { "name": "feePercent", "label": "Service fee (%)", "source": "ask", "type": "number", "required": true },
    { "name": "gstPercent", "label": "GST on the fee (%)", "source": "ask", "type": "number", "default": 18 },
    { "name": "examplePrice", "label": "Illustration ticket price", "source": "ask", "type": "money", "default": 1000 },
    { "name": "payoutDays", "label": "Payout within (days)", "source": "ask", "type": "number", "default": 7 },
    { "name": "term", "label": "Term", "source": "ask", "type": "string", "default": "one (1) year" },
    { "name": "noticeDays", "label": "Notice period (days)", "source": "ask", "type": "number", "default": 30 },
    { "name": "governingLaw", "label": "Governing law", "source": "ask", "type": "string", "default": "India" },
    { "name": "jurisdiction", "label": "Courts at", "source": "ask", "type": "string" },
    { "name": "print", "source": "computed:print" },
    { "name": "signatory", "source": "signatory", "required": true },
    { "name": "watermark", "label": "Draft watermark", "source": "ask", "type": "boolean", "default": false,
      "help": "Print params.watermark.text diagonally on every page (for drafts sent for review)" }
  ]
}
