{
  "id": "invoice",
  "version": 1,
  "type": "Invoice",
  "title": "Invoice",
  "description": "Tax invoice: items with HSN/SAC codes, tax lines from the brand tax modes, bank details.",
  "category": "invoice",
  "layoutProfile": "invoice",
  "partyType": "Client",
  "partyKind": "client",
  "sensitivity": "Internal",
  "renditions": ["pdf", "html", "md"],
  "numbering": { "series": "brand", "required": true },
  "contact": "billing",
  "params": {
    "title": "INVOICE",
    "numberLabel": "INVOICE NO",
    "dateLabel": "DATE",
    "partyLabel": "BILL TO",
    "fromLabel": "FROM",
    "columns": [
      { "key": "index", "label": "S.NO", "width": 35, "padX": 8 },
      { "key": "description", "label": "DESCRIPTION", "width": 275 },
      { "key": "hsn", "label": "HSN/SAC", "width": 80, "align": "center", "default": "{tax.defaultHsn}" },
      { "key": "amount", "label": "AMOUNT", "width": 125.28, "align": "right", "padX": 8 }
    ],
    "rowHeight": "auto",
    "descriptionWeight": "Medium",
    "subtotalLabel": "Subtotal",
    "totalLabel": "Total Invoice",
    "showBank": true,
    "bankTitle": "BANK DETAILS",
    "acknowledgement": false,
    "taxIdLabel": "GSTIN",
    "declarationTitle": "Declaration",
    "declarationString": "invoiceDeclaration",
    "declaration": "We declare that this invoice shows the actual price of the goods or services described and that all particulars are true and correct.",
    "thankYouString": "thankYou",
    "signatureAlt": "Signature of {name}"
  },
  "fields": [
    { "name": "brand", "source": "brand", "required": true },
    { "name": "client", "label": "Client", "source": "entity:client", "required": true },
    { "name": "billTo.name", "label": "Bill to (name)", "source": "client.name", "type": "string", "required": true },
    { "name": "billTo.address", "label": "Bill to (address)", "source": "client.attrs.address", "help": "Address lines (a list or text with line breaks)" },
    { "name": "date", "label": "Invoice date", "source": "today", "type": "date", "required": true },
    { "name": "items", "label": "Items", "source": "ask", "type": "array", "required": true,
      "item": { "description": "text", "hsn": "string", "amount": "money" },
      "help": "[{ description, hsn?, amount }]; hsn defaults to the brand's tax.defaultHsn" },
    { "name": "taxMode", "label": "Tax", "source": "ask", "type": "enum", "enum": "brand.tax.modes", "default": "brand.tax.defaultMode" },
    { "name": "totals", "source": "computed:totals" },
    { "name": "total", "source": "computed:total", "type": "money" },
    { "name": "bankAccount", "label": "Bank account", "source": "ask", "type": "string", "help": "Account number or 0-based index in brand.bankAccounts; default the first" },
    { "name": "bank", "source": "computed:bank" },
    { "name": "rowHeight", "label": "Item row height", "source": "ask", "help": "Points, or \"auto\" to fit the description" },
    { "name": "descriptionWeight", "label": "Description weight", "source": "ask", "type": "enum", "enum": ["Medium", "Bold"] },
    { "name": "layout", "source": "computed:layout" },
    { "name": "signatory", "source": "signatory", "required": true },
    { "name": "seal", "label": "Company seal", "source": "ask", "type": "boolean", "default": false }
  ],
  "leaf": "Invoices and Receipts"
}
