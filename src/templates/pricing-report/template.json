{
  "id": "pricing-report",
  "version": 1,
  "type": "Pricing Report",
  "title": "Pricing report",
  "description": "Ticket pricing report for a client: cover with the document details, contents with page numbers and sections given as data, with the Delegate Paid and Organiser Paid fee calculator tables.",
  "category": "report",
  "layoutProfile": "letter",
  "partyType": "Client",
  "partyKind": "client",
  "sensitivity": "Internal",
  "renditions": [
    "pdf",
    "html",
    "md"
  ],
  "numbering": {
    "series": "brand",
    "required": true
  },
  "contact": "default",
  "params": {
    "dateStyle": "us",
    "cover": {
      "style": "report",
      "title": "Ticket Pricing Models",
      "subtitle": "{event}",
      "preparedForLabel": "Prepared for",
      "preparedByLabel": "Prepared by",
      "preparedBy": "{companyUpper}",
      "detailsTitle": "Document Details",
      "details": [
        "Report Number: {number}",
        "Date: {date}",
        "Client: {clientLine}"
      ]
    },
    "contents": {
      "title": "Contents"
    },
    "headings": {
      "section": "{title}",
      "subsection": "{title}",
      "contents": "{title}",
      "contentsSubsection": "{title}",
      "subsectionsInContents": false
    },
    "fees": {
      "platformPercent": 2,
      "gstPercent": 18,
      "gatewayPercent": 2,
      "gatewayGstPercent": 18
    },
    "feeCard": {
      "label": "PLATFORM FEE",
      "value": "{platformPercent}%",
      "title": "Per paid ticket",
      "text": "{platformPercent}% platform fee plus {gstPercent}% GST on each paid ticket."
    },
    "priceCard": {
      "label": "TOTAL AMOUNT",
      "taxLabel": "Including GST",
      "title": "Fixed fee",
      "text": "",
      "words": "In words: {amountWords} ({taxLabel})"
    },
    "signOff": {
      "contactHeading": "PROJECT CONTACT",
      "signatoryHeading": "AUTHORIZED SIGNATORY",
      "rows": [
        {
          "label": "Name:",
          "value": "{name}"
        },
        {
          "label": "Designation:",
          "value": "{title}"
        },
        {
          "label": "Email:",
          "value": "{email}"
        },
        {
          "label": "Phone:",
          "value": "{phone}"
        }
      ]
    },
    "feeTables": {
      "registrations": {
        "layout": "perBase",
        "columns": [
          {
            "label": "Base Price",
            "width": 85,
            "value": "base"
          },
          {
            "label": "Platform\nFee ({platformPercent}%)",
            "width": 75,
            "value": "platformFee"
          },
          {
            "label": "GST on\nPlatform Fee",
            "width": 75,
            "value": "platformGst"
          },
          {
            "label": "PG Fee\n({gatewayPercent}% of Base+PF+PF GST)",
            "width": 65,
            "value": "gatewayFee"
          },
          {
            "label": "GST on\nGateway Fee",
            "width": 65,
            "value": "gatewayGst"
          },
          {
            "label": "Total\nCharges",
            "width": 80,
            "value": "totalCharges"
          },
          {
            "label": "Total Paid\nby Delegate",
            "width": 75,
            "value": "delegateTotal"
          }
        ]
      },
      "comparison": {
        "columns": [
          {
            "label": "Particulars",
            "width": 210
          },
          {
            "label": "Delegate Paid",
            "width": 155,
            "align": "right"
          },
          {
            "label": "Organiser Paid",
            "align": "right"
          }
        ],
        "rows": [
          {
            "label": "Base Ticket Price",
            "values": [
              "base",
              "base"
            ],
            "bold": true
          },
          {
            "label": "Platform Fee ({platformPercent}%)",
            "values": [
              "platformFee",
              "platformFee"
            ]
          },
          {
            "label": "GST on Platform Fee ({gstPercent}%)",
            "values": [
              "platformGst",
              "platformGst"
            ]
          },
          {
            "label": "Amount Processed by Payment Gateway",
            "values": [
              "processed",
              "base"
            ],
            "bold": true
          },
          {
            "label": "Payment Gateway Fee ({gatewayPercent}%)",
            "values": [
              "gatewayFee",
              "orgGatewayFee"
            ]
          },
          {
            "label": "GST on Payment Gateway Fee ({gatewayGstPercent}%)",
            "values": [
              "gatewayGst",
              "orgGatewayGst"
            ]
          },
          {
            "label": "Final Amount Paid by Delegate",
            "values": [
              "delegateTotal",
              "base"
            ],
            "total": true
          },
          {
            "label": "Amount Received by Organiser",
            "values": [
              "received",
              "orgNet"
            ],
            "total": true
          }
        ]
      },
      "delegatePaid": {
        "columns": [
          {
            "label": "Description",
            "width": 340
          },
          {
            "label": "Amount",
            "align": "right"
          }
        ],
        "rows": [
          {
            "label": "Base Ticket Price",
            "values": [
              "base"
            ]
          },
          {
            "label": "Platform Fee",
            "values": [
              "platformFee"
            ]
          },
          {
            "label": "GST on Platform Fee",
            "values": [
              "platformGst"
            ]
          },
          {
            "label": "Payment Gateway Fee",
            "values": [
              "gatewayFee"
            ]
          },
          {
            "label": "GST on Payment Gateway Fee",
            "values": [
              "gatewayGst"
            ]
          },
          {
            "label": "Final Amount Paid by Delegate",
            "values": [
              "delegateTotal"
            ],
            "total": true
          },
          {
            "label": "Amount Received by Organiser",
            "values": [
              "received"
            ],
            "total": true
          }
        ]
      },
      "organiserPaid": {
        "columns": [
          {
            "label": "Description",
            "width": 340
          },
          {
            "label": "Amount",
            "align": "right"
          }
        ],
        "rows": [
          {
            "label": "Amount Paid by Delegate",
            "values": [
              "base"
            ]
          },
          {
            "label": "Platform Fee",
            "values": [
              "platformFee"
            ]
          },
          {
            "label": "GST on Platform Fee",
            "values": [
              "platformGst"
            ]
          },
          {
            "label": "Payment Gateway Fee",
            "values": [
              "orgGatewayFee"
            ]
          },
          {
            "label": "GST on Payment Gateway Fee",
            "values": [
              "orgGatewayGst"
            ]
          },
          {
            "label": "Amount Received by Organiser (Net)",
            "values": [
              "orgNet"
            ],
            "total": true
          }
        ]
      },
      "summary": {
        "columns": [
          {
            "label": "Metric",
            "width": 210
          },
          {
            "label": "Delegate Paid",
            "width": 155,
            "align": "right"
          },
          {
            "label": "Organiser Paid",
            "align": "right"
          }
        ],
        "rows": [
          {
            "label": "Amount Paid by Delegate",
            "values": [
              "delegateTotal",
              "base"
            ],
            "bold": true
          },
          {
            "label": "Amount Received by Organiser",
            "values": [
              "received",
              "orgNet"
            ],
            "bold": true
          },
          {
            "label": "Platform Revenue",
            "values": [
              "platformFee",
              "platformFee"
            ]
          }
        ]
      },
      "tiers": {
        "layout": "tiers",
        "columns": [
          {
            "label": "Particulars",
            "width": 210
          },
          {
            "label": "{base} Ticket",
            "width": 155,
            "align": "right"
          }
        ],
        "rows": [
          {
            "label": "Base Ticket Price",
            "value": "base",
            "bold": true
          },
          {
            "label": "Platform Fee ({platformPercent}%)",
            "value": "platformFee"
          },
          {
            "label": "GST on Platform Fee ({gstPercent}%)",
            "value": "platformGst"
          },
          {
            "label": "Amount Processed by Payment Gateway",
            "value": "processed",
            "bold": true
          },
          {
            "label": "Payment Gateway Fee ({gatewayPercent}%)",
            "value": "gatewayFee"
          },
          {
            "label": "GST on Payment Gateway Fee ({gatewayGstPercent}%)",
            "value": "gatewayGst"
          }
        ]
      },
      "tierSummary": {
        "layout": "tiers",
        "columns": [
          {
            "label": "Metric",
            "width": 210
          },
          {
            "label": "{base} Ticket",
            "width": 155,
            "align": "right"
          }
        ],
        "rows": [
          {
            "label": "Base Ticket Price",
            "value": "base"
          },
          {
            "label": "Final Paid by Delegate",
            "value": "delegateTotal",
            "bold": true
          },
          {
            "label": "Received by Organiser (Net)",
            "value": "received",
            "bold": true
          },
          {
            "label": "Platform Revenue",
            "value": "platformFee"
          }
        ]
      }
    },
    "sections": [
      {
        "title": "Overview",
        "blocks": [
          {
            "type": "paragraph",
            "text": "This document sets out the ticket pricing models available to {client} for events run on {product}, with the charges that apply to paid tickets."
          },
          {
            "type": "paragraph",
            "text": "Free events carry no platform or payment gateway charges. For paid events the organiser chooses, event by event, whether the participant or the organiser bears the charges."
          }
        ]
      },
      {
        "title": "Charge Calculation",
        "blocks": [
          {
            "type": "paragraph",
            "text": "The following charges apply to paid events. For this illustration, the base ticket price is {examplePrice}."
          },
          {
            "type": "bullets",
            "items": [
              "Platform Fee: {platformPercent}% of the base ticket price.",
              "GST on Platform Fee: {gstPercent}% of the platform fee.",
              "Payment Gateway Fee: {gatewayPercent}% of the processed transaction amount.",
              "GST on Payment Gateway Fee: {gatewayGstPercent}% of the payment gateway fee."
            ]
          },
          {
            "type": "custom",
            "name": "feeTable",
            "data": {
              "kind": "comparison"
            }
          }
        ]
      },
      {
        "title": "Pricing Model: Delegate Paid",
        "newPage": true,
        "blocks": [
          {
            "type": "paragraph",
            "text": "Under this model the participant pays the ticket price together with all platform and payment gateway charges, and the organiser receives the full ticket price."
          },
          {
            "type": "custom",
            "name": "feeTable",
            "data": {
              "kind": "delegatePaid"
            }
          }
        ]
      },
      {
        "title": "Pricing Model: Organiser Paid",
        "level": 2,
        "blocks": [
          {
            "type": "paragraph",
            "text": "Under this model the participant pays only the ticket price, and the organiser bears the platform and payment gateway charges."
          },
          {
            "type": "custom",
            "name": "feeTable",
            "data": {
              "kind": "organiserPaid"
            }
          }
        ]
      },
      {
        "title": "Summary",
        "newPage": true,
        "blocks": [
          {
            "type": "custom",
            "name": "feeTable",
            "data": {
              "kind": "summary"
            }
          },
          {
            "type": "paragraph",
            "text": "Figures are for a base ticket price of {examplePrice}. Free events have no charges under either model."
          }
        ]
      },
      {
        "title": "Notes",
        "blocks": [
          {
            "type": "bullets",
            "items": [
              "Free events are hosted at no cost to the organiser or the participants.",
              "Paid events carry a {platformPercent}% platform fee plus {gstPercent}% GST, and a {gatewayPercent}% payment gateway fee plus {gatewayGstPercent}% GST.",
              "The organiser may choose the Delegate Paid or the Organiser Paid model for each event."
            ]
          }
        ]
      }
    ],
    "footer": {}
  },
  "fields": [
    {
      "name": "brand",
      "source": "brand",
      "required": true
    },
    {
      "name": "client",
      "label": "Client",
      "source": "entity:client",
      "required": true
    },
    {
      "name": "engagement",
      "label": "Engagement",
      "source": "entity:engagement",
      "help": "The event or project; its name fills {event}"
    },
    {
      "name": "product",
      "label": "Product",
      "source": "entity:product",
      "help": "Its name fills {product} (default: the brand's short name)"
    },
    {
      "name": "date",
      "label": "Date",
      "source": "today",
      "type": "date",
      "required": true
    },
    {
      "name": "coverTitle",
      "label": "Cover title",
      "source": "ask",
      "type": "string",
      "help": "Default: params.cover.title"
    },
    {
      "name": "subtitle",
      "label": "Cover subtitle",
      "source": "ask",
      "type": "string",
      "help": "Default: the engagement's name"
    },
    {
      "name": "preparedFor",
      "label": "Prepared for",
      "source": "ask",
      "type": "text",
      "help": "Default: the client's name"
    },
    {
      "name": "clientLine",
      "label": "Client line",
      "source": "client.name",
      "type": "string",
      "help": "Printed after 'Client:' in the document details (default: the client's name)"
    },
    {
      "name": "event",
      "label": "Event name",
      "source": "ask",
      "type": "string",
      "help": "Overrides the engagement's name in {event}"
    },
    {
      "name": "examplePrice",
      "label": "Example ticket price",
      "source": "ask",
      "type": "money",
      "default": 1000,
      "help": "Base price of the fee tables without their own base"
    },
    {
      "name": "fees",
      "label": "Fee rates",
      "source": "ask",
      "type": "object",
      "help": "{ platformPercent, gstPercent, gatewayPercent, gatewayGstPercent } over params.fees"
    },
    {
      "name": "rates",
      "source": "computed:rates"
    },
    {
      "name": "projectContact",
      "label": "Project contact",
      "source": "ask",
      "type": "string",
      "help": "Brand signatory id for a sign-off block"
    },
    {
      "name": "signatory",
      "label": "Signatory",
      "source": "signatory",
      "help": "Only used by a signOff block"
    },
    {
      "name": "signOff",
      "source": "computed:signOff"
    },
    {
      "name": "sections",
      "label": "Sections",
      "source": "ask",
      "type": "array",
      "help": "[{ title, blocks, subsections?: [{ title, blocks }] }]; default: params.sections"
    },
    {
      "name": "sectionList",
      "source": "computed:sections"
    }
  ],
  "relations": []
}
