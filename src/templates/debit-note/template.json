{
  "id": "debit-note",
  "version": 1,
  "type": "Debit Note",
  "title": "Debit note",
  "description": "Debit note for reimbursable charges, optionally against an invoice (relation adjusts).",
  "category": "invoice",
  "layoutProfile": "invoice",
  "partyType": "Client",
  "partyKind": "client",
  "sensitivity": "Internal",
  "renditions": ["pdf", "html", "md"],
  "numbering": { "series": "brand", "required": true },
  "contact": "billing",
  "params": {
    "title": "DEBIT NOTE",
    "numberLabel": "DEBIT NOTE NO",
    "dateLabel": "DATE",
    "partyLabel": "DEBIT TO",
    "fromLabel": "FROM",
    "columns": [
      { "key": "index", "label": "S.NO", "width": 35, "padX": 8 },
      { "key": "description", "label": "DESCRIPTION", "width": 275 },
      { "key": "hsn", "label": "HSN/SAC", "width": 80, "align": "center", "default": "—" },
      { "key": "amount", "label": "AMOUNT", "width": 125.28, "align": "right", "padX": 8 }
    ],
    "rowHeight": 24,
    "taxable": false,
    "subtotalLabel": "Subtotal",
    "totalLabel": "Total Debit Note",
    "showBank": true,
    "bankTitle": "BANK DETAILS",
    "acknowledgement": false,
    "taxIdLabel": "GSTIN",
    "declarationTitle": "Declaration",
    "declarationString": "debitNoteDeclaration",
    "declaration": "We declare that this debit note shows the actual amounts of the charges described and that all particulars are true and correct.",
    "thankYouString": "thankYou",
    "frame": {
      "meta": { "labelInset": 100 },
      "table": { "row": { "textDy": 7, "descriptionLineGap": null }, "ruleColor": "#cbd5e1" }
    }
  },
  "fields": [
    { "name": "brand", "source": "brand", "required": true },
    { "name": "client", "label": "Client", "source": "entity:client", "required": true },
    { "name": "billTo.name", "label": "Debit to (name)", "source": "client.name", "type": "string", "required": true },
    { "name": "billTo.address", "label": "Debit to (address)", "source": "client.attrs.address", "help": "Address lines (a list or text with line breaks)" },
    { "name": "date", "label": "Date", "source": "today", "type": "date", "required": true },
    { "name": "items", "label": "Items", "source": "ask", "type": "array", "required": true,
      "item": { "description": "text", "hsn": "string", "amount": "money" },
      "help": "[{ description, hsn?, amount }]" },
    { "name": "invoice", "label": "Invoice adjusted", "source": "ask", "type": "string", "help": "Document id of the invoice this debit note adjusts" },
    { "name": "totals", "source": "computed:totals" },
    { "name": "total", "source": "computed:total", "type": "money" },
    { "name": "bankAccount", "label": "Bank account", "source": "ask", "type": "string", "help": "Account number or 0-based index in brand.bankAccounts; default the first" },
    { "name": "bank", "source": "computed:bank" },
    { "name": "rowHeight", "label": "Item row height", "source": "ask", "help": "Points, or \"auto\" to fit the description" },
    { "name": "descriptionWeight", "label": "Description weight", "source": "ask", "type": "enum", "enum": ["Medium", "Bold"] },
    { "name": "layout", "source": "computed:layout" },
    { "name": "signatory", "source": "signatory", "required": true },
    { "name": "seal", "label": "Company seal", "source": "ask", "type": "boolean", "default": false }
  ],
  "relations": [{ "type": "adjusts", "field": "invoice", "optional": true }],
  "leaf": "Invoices and Receipts"
}
